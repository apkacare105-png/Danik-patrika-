# Supabase प्रोजेक्ट की Settings > API से लें।
# खाली छोड़ने पर पोर्टल "डेमो मोड" में चलता है (मॉक हिंदी डेटा, बिना लॉगिन)।
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GNews API (server-side only; never expose as NEXT_PUBLIC_)
GNEWS_API_KEY=
