# Supabase प्रोजेक्ट की Settings > API से लें।
# खाली छोड़ने पर पोर्टल "डेमो मोड" में चलता है (मॉक हिंदी डेटा, बिना लॉगिन)।
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GNews API (server-side only; never expose as NEXT_PUBLIC_)
GNEWS_API_KEY=

# संपादकीय AI एजेंट (सिर्फ़ सर्वर पर; NEXT_PUBLIC_ से कभी नहीं)
ANTHROPIC_API_KEY=
# वैकल्पिक: मॉडल बदलने के लिए (डिफ़ॉल्ट claude-sonnet-5-5)
ANTHROPIC_MODEL=
